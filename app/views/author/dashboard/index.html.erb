<div class="min-h-screen bg-gray-50 py-8">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-navy-800">작가 대시보드</h1>
      <p class="text-gray-600 mt-2">안녕하세요, <%= @user.name %> 작가님!</p>
    </div>

    <!-- 통계 카드 -->
    <div class="grid md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-gray-500">총 콘텐츠</span>
          <span class="text-2xl">📚</span>
        </div>
        <p class="text-3xl font-bold text-navy-800"><%= @total_courses %></p>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-gray-500">총 수강생</span>
          <span class="text-2xl">👥</span>
        </div>
        <p class="text-3xl font-bold text-navy-800"><%= @total_students %></p>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-gray-500">총 수익</span>
          <span class="text-2xl">💰</span>
        </div>
        <p class="text-3xl font-bold text-green-600"><%= number_to_currency(@total_revenue, unit: '₩', precision: 0) %></p>
      </div>

      <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-gray-500">이번 달 수익</span>
          <span class="text-2xl">📈</span>
        </div>
        <p class="text-3xl font-bold text-accent-500"><%= number_to_currency(@monthly_revenue, unit: '₩', precision: 0) %></p>
      </div>
    </div>

    <!-- 수익 차트 -->
    <div class="bg-white rounded-xl shadow-md p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-800 mb-4">월별 수익 추이</h2>
      <div class="h-64 flex items-end justify-between gap-2">
        <% max_revenue = @revenue_chart_data.map { |d| d[:revenue] }.max %>
        <% @revenue_chart_data.each do |data| %>
          <div class="flex-1 flex flex-col items-center">
            <div class="w-full bg-primary-400 rounded-t hover:bg-primary-500 transition-all" 
                 style="height: <%= max_revenue > 0 ? (data[:revenue] / max_revenue * 200).to_i : 0 %>px;">
            </div>
            <p class="text-xs text-gray-600 mt-2"><%= data[:month][5..6] %>월</p>
            <p class="text-xs font-semibold text-gray-800"><%= number_to_currency(data[:revenue], unit: '₩', precision: 0) %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- 내 콘텐츠 -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold text-gray-800">내 콘텐츠</h2>
          <%= link_to '+ 새 콘텐츠', new_admin_course_path, class: 'text-primary-500 hover:text-primary-600 font-medium' %>
        </div>
        <div class="space-y-4">
          <% @courses.limit(5).each do |course| %>
            <div class="flex justify-between items-center p-4 bg-gray-50 rounded-lg">
              <div>
                <h3 class="font-semibold text-gray-800"><%= course.title %></h3>
                <p class="text-sm text-gray-600">수강생: <%= course.enrollments.count %>명 | 평점: <%= course.reviews.average(:rating)&.round(1) || 'N/A' %></p>
              </div>
              <%= link_to '관리', admin_course_path(course), class: 'text-primary-500 hover:text-primary-600' %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- 최근 리뷰 -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">최근 리뷰</h2>
        <div class="space-y-4">
          <% @recent_reviews.each do |review| %>
            <div class="p-4 bg-gray-50 rounded-lg">
              <div class="flex justify-between items-start mb-2">
                <div class="flex items-center">
                  <% review.rating.times do %>
                    <span class="text-yellow-400">★</span>
                  <% end %>
                  <span class="ml-2 text-sm text-gray-600"><%= review.user.name %></span>
                </div>
                <span class="text-xs text-gray-500"><%= review.created_at.strftime('%Y.%m.%d') %></span>
              </div>
              <p class="text-sm text-gray-700"><%= review.content %></p>
              <p class="text-xs text-gray-500 mt-1">콘텐츠: <%= review.course.title %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- 빠른 액세스 -->
    <div class="mt-8 bg-gradient-to-r from-primary-50 to-accent-50 rounded-xl p-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">빠른 액세스</h2>
      <div class="grid md:grid-cols-4 gap-4">
        <%= link_to admin_courses_path, class: 'bg-white p-4 rounded-lg hover:shadow-md transition-shadow' do %>
          <span class="text-2xl mb-2">📝</span>
          <p class="font-semibold text-gray-800">콘텐츠 관리</p>
        <% end %>
        <%= link_to new_admin_course_path, class: 'bg-white p-4 rounded-lg hover:shadow-md transition-shadow' do %>
          <span class="text-2xl mb-2">➕</span>
          <p class="font-semibold text-gray-800">새 콘텐츠</p>
        <% end %>
        <%= link_to admin_reviews_path, class: 'bg-white p-4 rounded-lg hover:shadow-md transition-shadow' do %>
          <span class="text-2xl mb-2">⭐</span>
          <p class="font-semibold text-gray-800">리뷰 관리</p>
        <% end %>
        <%= link_to '#', class: 'bg-white p-4 rounded-lg hover:shadow-md transition-shadow' do %>
          <span class="text-2xl mb-2">💵</span>
          <p class="font-semibold text-gray-800">정산 내역</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

