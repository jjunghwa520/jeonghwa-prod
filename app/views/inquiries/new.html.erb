<div class="min-h-screen bg-gray-50 py-12">
  <div class="container mx-auto px-4 max-w-3xl">
    <h1 class="text-3xl font-bold text-navy-800 mb-8">1:1 문의하기</h1>

    <div class="bg-white rounded-xl shadow-md p-8">
      <%= form_with model: @inquiry, local: true, class: 'space-y-6' do |f| %>
        <div>
          <%= f.label :title, '제목', class: 'block text-sm font-semibold text-gray-700 mb-2' %>
          <%= f.text_field :title, class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-400 focus:border-transparent', placeholder: '문의 제목을 입력하세요' %>
        </div>

        <div>
          <%= f.label :content, '문의 내용', class: 'block text-sm font-semibold text-gray-700 mb-2' %>
          <%= f.text_area :content, rows: 10, class: 'w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-400 focus:border-transparent', placeholder: '문의 내용을 자세히 입력해주세요' %>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <p class="text-sm text-blue-800">
            📌 문의 답변은 영업일 기준 1~2일 내에 등록하신 이메일로 회신됩니다.
          </p>
        </div>

        <div class="flex gap-4">
          <%= f.submit '문의 등록', class: 'flex-1 bg-primary-500 hover:bg-primary-600 text-white font-bold py-3 px-6 rounded-lg transition-colors' %>
          <%= link_to '취소', inquiries_path, class: 'px-6 py-3 text-gray-600 hover:text-gray-800' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

