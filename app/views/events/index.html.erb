<div class="min-h-screen bg-gray-50 py-12">
  <div class="container mx-auto px-4 max-w-6xl">
    <h1 class="text-4xl font-bold text-navy-800 mb-8">🎉 이벤트 & 프로모션</h1>

    <!-- 진행중인 이벤트 -->
    <% if @active_events.any? %>
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">진행중인 이벤트</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @active_events.each do |event| %>
            <%= link_to event_path(event), class: 'block bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow' do %>
              <% if event.banner_image.present? %>
                <img src="<%= event.banner_image %>" alt="<%= event.title %>" class="w-full h-48 object-cover">
              <% else %>
                <div class="w-full h-48 bg-gradient-to-r from-accent-400 to-primary-400 flex items-center justify-center">
                  <span class="text-white text-6xl">🎊</span>
                </div>
              <% end %>
              <div class="p-6">
                <span class="px-3 py-1 bg-red-100 text-red-600 text-xs font-semibold rounded-full"><%= event.discount_rate %>% 할인</span>
                <h3 class="text-xl font-bold text-gray-800 mt-3 mb-2"><%= event.title %></h3>
                <p class="text-gray-600 text-sm mb-4 line-clamp-2"><%= event.description %></p>
                <p class="text-sm text-gray-500">~ <%= event.end_date.strftime('%Y.%m.%d') %>까지</p>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- 예정된 이벤트 -->
    <% if @upcoming_events.any? %>
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">곧 시작되는 이벤트</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <% @upcoming_events.each do |event| %>
            <div class="bg-white rounded-xl shadow-md p-6 opacity-75">
              <span class="px-3 py-1 bg-gray-200 text-gray-600 text-xs font-semibold rounded-full">Coming Soon</span>
              <h3 class="text-lg font-bold text-gray-800 mt-3"><%= event.title %></h3>
              <p class="text-sm text-gray-500 mt-2"><%= event.start_date.strftime('%Y.%m.%d') %> 시작 예정</p>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>

