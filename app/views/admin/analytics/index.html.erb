<div class="min-h-screen bg-gray-50 py-8">
  <div class="container mx-auto px-4 max-w-7xl">
    <h1 class="text-3xl font-bold text-navy-800 mb-8">📊 통계 & 리포트</h1>

    <!-- 전체 통계 카드 -->
    <div class="grid md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-xl shadow-md p-6">
        <p class="text-sm text-gray-500 mb-2">총 회원 수</p>
        <p class="text-3xl font-bold text-navy-800"><%= number_with_delimiter(@total_users) %></p>
      </div>
      <div class="bg-white rounded-xl shadow-md p-6">
        <p class="text-sm text-gray-500 mb-2">총 콘텐츠</p>
        <p class="text-3xl font-bold text-navy-800"><%= number_with_delimiter(@total_courses) %></p>
      </div>
      <div class="bg-white rounded-xl shadow-md p-6">
        <p class="text-sm text-gray-500 mb-2">활성 구독</p>
        <p class="text-3xl font-bold text-green-600"><%= number_with_delimiter(@total_subscriptions) %></p>
      </div>
      <div class="bg-white rounded-xl shadow-md p-6">
        <p class="text-sm text-gray-500 mb-2">이번 달 매출</p>
        <p class="text-3xl font-bold text-accent-500"><%= number_to_currency(@monthly_revenue, unit: '₩', precision: 0) %></p>
      </div>
    </div>

    <!-- 차트들 -->
    <div class="grid md:grid-cols-2 gap-8 mb-8">
      <!-- 가입자 추이 -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">일일 가입자 추이 (30일)</h2>
        <div class="h-64 flex items-end justify-between gap-1">
          <% max_signup = @signup_chart_data.map { |d| d[:count] }.max || 1 %>
          <% @signup_chart_data.each do |data| %>
            <div class="flex-1 flex flex-col items-center">
              <div class="w-full bg-primary-400 rounded-t hover:bg-primary-500" 
                   style="height: <%= (data[:count] / max_signup.to_f * 200).to_i %>px;"></div>
              <p class="text-xs text-gray-600 mt-1"><%= data[:date] %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- 매출 추이 -->
      <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">일일 매출 추이 (30일)</h2>
        <div class="h-64 flex items-end justify-between gap-1">
          <% max_revenue = @revenue_chart_data.map { |d| d[:amount] }.max || 1 %>
          <% @revenue_chart_data.each do |data| %>
            <div class="flex-1 flex flex-col items-center">
              <div class="w-full bg-green-400 rounded-t hover:bg-green-500" 
                   style="height: <%= (data[:amount] / max_revenue.to_f * 200).to_i %>px;"></div>
              <p class="text-xs text-gray-600 mt-1"><%= data[:date] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- 인기 콘텐츠 -->
    <div class="bg-white rounded-xl shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-800 mb-4">인기 콘텐츠 TOP 10</h2>
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold">순위</th>
            <th class="px-4 py-3 text-left text-sm font-semibold">콘텐츠명</th>
            <th class="px-4 py-3 text-left text-sm font-semibold">수강생</th>
            <th class="px-4 py-3 text-left text-sm font-semibold">평점</th>
          </tr>
        </thead>
        <tbody>
          <% @popular_courses.each_with_index do |course, index| %>
            <tr class="border-t hover:bg-gray-50">
              <td class="px-4 py-3"><%= index + 1 %></td>
              <td class="px-4 py-3 font-semibold"><%= course.title %></td>
              <td class="px-4 py-3"><%= course.enrollment_count %></td>
              <td class="px-4 py-3">⭐ <%= course.reviews.average(:rating)&.round(1) || 'N/A' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

