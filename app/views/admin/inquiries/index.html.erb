<div class="min-h-screen bg-gray-50 py-8">
  <div class="container mx-auto px-4 max-w-7xl">
    <h1 class="text-3xl font-bold text-navy-800 mb-8">1:1 문의 관리</h1>

    <!-- 대기중인 문의 -->
    <div class="mb-8">
      <h2 class="text-xl font-bold text-gray-800 mb-4">대기중인 문의 (<%= @pending_inquiries.count %>)</h2>
      <div class="space-y-4">
        <% if @pending_inquiries.any? %>
          <% @pending_inquiries.each do |inquiry| %>
            <div class="bg-white rounded-lg shadow p-6">
              <div class="flex justify-between items-start mb-3">
                <h3 class="text-lg font-semibold text-gray-800"><%= inquiry.title %></h3>
                <span class="px-3 py-1 bg-yellow-100 text-yellow-800 text-sm font-semibold rounded-full">
                  대기중
                </span>
              </div>
              <p class="text-sm text-gray-600 mb-2">작성자: <%= inquiry.user.name %> (<%= inquiry.user.email %>)</p>
              <p class="text-sm text-gray-500 mb-4">작성일: <%= inquiry.created_at.strftime('%Y.%m.%d %H:%M') %></p>
              <p class="text-gray-700 mb-4"><%= inquiry.content %></p>
              <%= link_to '답변하기', admin_inquiry_path(inquiry), class: 'inline-block bg-primary-500 hover:bg-primary-600 text-white px-4 py-2 rounded-lg' %>
            </div>
          <% end %>
        <% else %>
          <div class="bg-white rounded-lg shadow p-12 text-center text-gray-500">
            대기중인 문의가 없습니다.
          </div>
        <% end %>
      </div>
    </div>

    <!-- 답변 완료된 문의 -->
    <div>
      <h2 class="text-xl font-bold text-gray-800 mb-4">최근 답변 완료 (<%= @answered_inquiries.count %>)</h2>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-sm font-semibold">제목</th>
              <th class="px-6 py-3 text-left text-sm font-semibold">작성자</th>
              <th class="px-6 py-3 text-left text-sm font-semibold">작성일</th>
              <th class="px-6 py-3 text-left text-sm font-semibold">상태</th>
            </tr>
          </thead>
          <tbody>
            <% if @answered_inquiries.any? %>
              <% @answered_inquiries.each do |inquiry| %>
                <tr class="border-t hover:bg-gray-50">
                  <td class="px-6 py-4"><%= link_to inquiry.title, admin_inquiry_path(inquiry), class: 'text-primary-500 hover:text-primary-600' %></td>
                  <td class="px-6 py-4 text-sm"><%= inquiry.user.name %></td>
                  <td class="px-6 py-4 text-sm text-gray-600"><%= inquiry.created_at.strftime('%Y.%m.%d') %></td>
                  <td class="px-6 py-4">
                    <span class="px-3 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded-full">
                      답변완료
                    </span>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="px-6 py-8 text-center text-gray-500">답변 완료된 문의가 없습니다.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

