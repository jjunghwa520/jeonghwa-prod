<div class="min-h-screen bg-gray-50 py-8">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-navy-800">이벤트 관리</h1>
      <%= link_to '+ 새 이벤트', new_admin_event_path, class: 'bg-primary-500 hover:bg-primary-600 text-white px-6 py-3 rounded-lg font-semibold' %>
    </div>

    <div class="bg-white rounded-xl shadow-md overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">제목</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">기간</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">할인율</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">상태</th>
            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600">관리</th>
          </tr>
        </thead>
        <tbody>
          <% if @events.any? %>
            <% @events.each do |event| %>
              <tr class="border-t hover:bg-gray-50">
                <td class="px-6 py-4 font-semibold"><%= event.title %></td>
                <td class="px-6 py-4 text-sm text-gray-600">
                  <%= event.start_date.strftime('%Y.%m.%d') %> ~ <%= event.end_date.strftime('%Y.%m.%d') %>
                </td>
                <td class="px-6 py-4"><%= event.discount_rate %>%</td>
                <td class="px-6 py-4">
                  <span class="px-3 py-1 rounded-full text-xs font-semibold <%= event.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>">
                    <%= event.status %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <div class="flex gap-2">
                    <%= link_to '수정', edit_admin_event_path(event), class: 'text-blue-500 hover:text-blue-600' %>
                    <%= button_to '삭제', admin_event_path(event), method: :delete, data: { confirm: '정말 삭제하시겠습니까?' }, class: 'text-red-500 hover:text-red-600' %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                등록된 이벤트가 없습니다.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

